class Ticketfairy < Formula
  desc "Ticket Fairy command-line interface"
  homepage "https://github.com/theticketfairy/ticketfairy-cli"
  version "VERSION_PLACEHOLDER"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/theticketfairy/ticketfairy-cli/releases/download/vVERSION_PLACEHOLDER/ticketfairy-vVERSION_PLACEHOLDER-darwin-arm64.tar.gz"
      sha256 "DARWIN_ARM64_SHA"
    end
    on_intel do
      url "https://github.com/theticketfairy/ticketfairy-cli/releases/download/vVERSION_PLACEHOLDER/ticketfairy-vVERSION_PLACEHOLDER-darwin-x64.tar.gz"
      sha256 "DARWIN_X64_SHA"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/theticketfairy/ticketfairy-cli/releases/download/vVERSION_PLACEHOLDER/ticketfairy-vVERSION_PLACEHOLDER-linux-arm64.tar.gz"
      sha256 "LINUX_ARM64_SHA"
    end
    on_intel do
      url "https://github.com/theticketfairy/ticketfairy-cli/releases/download/vVERSION_PLACEHOLDER/ticketfairy-vVERSION_PLACEHOLDER-linux-x64.tar.gz"
      sha256 "LINUX_X64_SHA"
    end
  end

  def install
    libexec.install Dir["*"]
    bin.install_symlink libexec/"bin/ticketfairy"
  end

  test do
    assert_match "@theticketfairy/cli", shell_output("#{bin}/ticketfairy --version")
  end
end
